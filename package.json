{
  "name": "clinic-booking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.web.json",
    "start": "node dist/server.js",
    "dev": "node --watch src/server.ts",
    "test": "node --test",
    "typecheck": "tsc",
    "build:web": "tsc -p tsconfig.web.json",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
