{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [],
    "outDir": "public",
    "rootDir": "src/web"
  },
  "include": ["src/web/**/*.ts"]
}
